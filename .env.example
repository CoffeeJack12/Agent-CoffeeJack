COFFEEJACK_PORT=3210
OLLAMA_URL=http://127.0.0.1:11434
COFFEEJACK_MODEL=qwen3:8b

# --- Account email delivery (SMTP) ------------------------------------------
# Production email is enabled only when BOTH COFFEEJACK_SMTP_HOST and
# COFFEEJACK_SMTP_FROM are set. Never commit real credentials.
COFFEEJACK_SMTP_HOST=
COFFEEJACK_SMTP_PORT=587
COFFEEJACK_SMTP_USER=
COFFEEJACK_SMTP_PASS=
COFFEEJACK_SMTP_FROM=CoffeeJack <no-reply@example.com>
# Set to "true" for implicit TLS (port 465); leave empty/false for STARTTLS.
COFFEEJACK_SMTP_SECURE=false
# Absolute base URL used in verification/reset email links. Optional.
COFFEEJACK_BASE_URL=

# --- Local development mailbox ----------------------------------------------
# When SMTP is NOT configured, set this to 1 to use an in-memory dev mailbox
# (readable at GET /api/auth/dev/mailbox on loopback) instead of real email.
# Production never silently falls back to the dev mailbox.
COFFEEJACK_AUTH_DEV=
