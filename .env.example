COFFEEJACK_PORT=3210
OLLAMA_URL=http://127.0.0.1:11434
COFFEEJACK_MODEL=qwen3:8b

# CoffeeJack accounts (no secrets in repo).
# Production SMTP via Nodemailer. Configured only when a host (or SMTP URL) is present.
# Production never falls back to the local dev mailbox.
#   COFFEEJACK_SMTP_HOST=smtp.example.com
#   COFFEEJACK_SMTP_PORT=587
#   COFFEEJACK_SMTP_USER=
#   COFFEEJACK_SMTP_PASSWORD=
#   COFFEEJACK_SMTP_FROM=
#   COFFEEJACK_SMTP_SECURE=0
# Backward compatible URL form:
#   COFFEEJACK_SMTP_URL=smtp://USER:PASSWORD@HOST:587
#   COFFEEJACK_SMTP_URL=smtps://USER:PASSWORD@HOST:465
# Optional install HMAC for 6-digit verify/reset codes. Generated and stored locally if unset.
#   COFFEEJACK_AUTH_HMAC_SECRET=
# Leave SMTP unset until a provider is available. CoffeeJack will not pretend mail was sent.
# Local development mailbox only. Never used when SMTP is configured.
# COFFEEJACK_AUTH_DEV=1
