{
  "name": "coffeejack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first personal AI workspace for Windows",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check public/app.js"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "exceljs": "^4.4.0",
    "mammoth": "^1.10.0",
    "marked": "^18.0.13",
    "pdfjs-dist": "^5.4.149",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "npm": "^12.0.2",
    "prettier": "^3.9.8"
  }
}
