# Copy to .env.local (gitignored) or set in the process environment.
# Never commit real values.

# Public hostname (no scheme/port)
COFFEEJACK_REMOTE_HOST=jack.example.com

# Access team domain
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com

# Access application AUD (64 hex chars) — not a password, still keep private
CF_ACCESS_AUD=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Comma-separated emails allowed through Access JWT email claim
CF_ACCESS_ALLOWED_EMAILS=owner@example.com,testuser@example.com

# Optional: first remote login with this verified email auto-links to local owner
CF_ACCESS_OWNER_EMAIL=owner@example.com

# Optional: auto-create standard users for other verified emails (default: pending)
# CF_ACCESS_AUTO_CREATE_ROLE=standard

# App listen (always loopback)
COFFEEJACK_PORT=3210
# OLLAMA_URL=http://127.0.0.1:11434
